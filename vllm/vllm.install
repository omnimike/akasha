post_install() {
  echo "=== Creating system users ==="
  systemd-sysusers

  echo "=== Reloading systemd manager configuration ==="
  systemctl daemon-reload

  echo "the servers do not start at boot by default"
  echo "  start manually with systemctl start vllm-qwen38.service vllm-qwen36.service vllm-muse-glimmer.service"
  echo "  enable at boot with systemctl enable vllm-qwen38.target vllm-qwen36.target vllm-muse-glimmer.target"
}

post_upgrade() {
  post_install "$@"
}

post_remove() {
  echo "=== Stopping services ==="
  systemctl disable --now vllm-qwen38.target vllm-qwen36.target vllm-muse-glimmer.target nvidia-cdi.service || true
  systemctl stop vllm-qwen38.service vllm-qwen36.service vllm-muse-glimmer.service || true

  echo "=== Removing podman images ==="
  podman rmi docker.io/vllm/vllm-openai:latest docker.io/vllm/vllm-openai:muse-glimmer || true

  echo "=== Removing managed data in /var/lib/vllm ==="
  rm -rf /var/lib/vllm

  echo "=== Removing system users ==="
  userdel vllm || true

  echo "=== Reloading systemd manager configuration ==="
  systemctl daemon-reload
}
