[Unit]
Description=Hermes Agent gateway
After=network-online.target vllm-qwen36.service multi-user.target
Wants=network-online.target vllm-qwen36.service

[Container]
Image=docker.io/nousresearch/hermes-agent:latest
Network=host
ContainerName=hermes-agent

# Data volume
Volume=/var/lib/local-agents/hermes:/opt/data

# Enable API server and dashboard
Environment=API_SERVER_ENABLED=true
Environment=HERMES_DASHBOARD=1

# Dashboard basic auth
Environment=HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
Environment=HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=changeme
Environment=HERMES_DASHBOARD_BASIC_AUTH_SECRET=15a5a5a553a5c7269a482f882d882876

# Command
Exec=gateway run

[Service]
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target