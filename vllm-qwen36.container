[Unit]
Description=vLLM Qwen3.6-27B-FP8 server
After=network-online.target nvidia-persistenced.service multi-user.target
Wants=network-online.target nvidia-persistenced.service

[Container]
Image=docker.io/vllm/vllm-openai:latest
Network=host
ContainerName=vllm-qwen36
AddDevice=nvidia.com/gpu=all
PodmanArgs=--ipc=host
Volume=/var/lib/local-agents:/root/.cache/huggingface

# Environment variables
Environment=VLLM_USE_DEEP_GEMM=0

# We are currently downloading the model when the container starts.
# These environment variables disable that.
# Environment=HF_HUB_OFFLINE=1
# Environment=TORCH_HUB_OFFLINE=1
# Environment=TORCH_DISTRIBUTED_DEBUG=OFF
# Environment=VLLM_NO_USAGE_STATS=1
# Environment=DO_NOT_TRACK=1

# Command line arguments
Exec=--model Qwen/Qwen3.6-27B-FP8 \
     --max-model-len 262144 \
     --gpu-memory-utilization 0.8 \
     --speculative-config '{"method": "mtp", "num_speculative_tokens": 2}' \
     --enable-prefix-caching \
     --enable-auto-tool-choice \
     --tool-call-parser qwen3_coder \
     --reasoning-parser qwen3 \
     --max-num-seqs 32

[Service]
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
