post_install() {
  echo "=== Creating system users ==="
  systemd-sysusers

  echo "=== Validating sudoers rule ==="
  visudo -cf /etc/sudoers.d/hermes-agent

  echo "=== Reloading systemd manager configuration ==="
  systemctl daemon-reload

  echo ""
  echo "=== hermes-agent: run the setup wizard first ==="
  echo "sudo hermes install"
  echo "This will:"
  echo "  - Build the custom hermes-agent image"
  echo "  - Run the interactive setup wizard (API keys, chat systems)"
  echo "  - Generate dashboard/API secrets"
  echo "  - Extract agent source for the WebUI"
  echo "Then enable the service:"
  echo "  systemctl enable --now hermes-agent.service hermes-webui.service"
}

post_upgrade() {
  post_install "$@"

  echo "=== Rebuilding hermes-agent image ==="
  systemctl restart hermes-agent-build.service || true

  if systemctl is-active --quiet hermes-agent.service; then
    echo "=== Restarting hermes-agent ==="
    systemctl restart hermes-agent.service || true
  fi
}

post_remove() {
  echo "=== Stopping services ==="
  systemctl disable --now hermes-agent-build.service hermes-agent.service hermes-webui.service || true

  echo "=== Removing podman images ==="
  podman rmi localhost/hermes-agent:latest || true
  podman rmi ghcr.io/nesquena/hermes-webui:latest || true

  echo "=== Removing managed data in /var/lib/hermes-agent ==="
  rm -rf /var/lib/hermes-agent/hermes
  rm -rf /var/lib/hermes-agent/hermes-agent-src

  echo "=== Removing workspace (if empty) ==="
  workspace_empty=false
  if [ -d /var/lib/hermes-agent/workspace ]; then
    if rmdir /var/lib/hermes-agent/workspace 2>/dev/null; then
      workspace_empty=true
      rmdir /var/lib/hermes-agent 2>/dev/null || true
    fi
  fi

  echo "=== Removing system users ==="
  userdel hermes || true
  if [ "$workspace_empty" = true ]; then
    groupdel agent || true
  fi

  echo "=== Reloading systemd manager configuration ==="
  systemctl daemon-reload
}
