#!/bin/bash
# hermes — interactive CLI chat session for hermes-agent.
# Runs in its own container, sharing the data volume with the gateway.

set -euo pipefail

IMAGE="docker.io/nousresearch/hermes-agent:latest"
ENV_FILE="/etc/local-agents/hermes-agent.env"

# Read the API server key for gateway auth
API_KEY=$(grep '^API_SERVER_KEY=' "$ENV_FILE" | cut -d= -f2-)

# Run a temporary container and connect to the gateway over the network.
# No volume mount needed—the hermes CLI communicates via the API.
podman run -it --rm \
    --network host \
    -e API_SERVER_KEY="$API_KEY" \
    -e API_SERVER_URL="http://localhost:9119" \
    "$IMAGE" hermes
