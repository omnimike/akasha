[Unit]
Description=Hermes Agent gateway
After=network-online.target hermes-agent-build.service
Wants=network-online.target hermes-agent-build.service

[Container]
# Locally built by hermes-agent-build.service (Quadlet .build unit)
Image=localhost/hermes-agent:latest
Network=host
ContainerName=hermes-agent

# Run as non-root hermes user (UID 10000, built into the image)
User=10000:10000

# Data volume
Volume=/var/lib/hermes-agent/hermes:/opt/data
Volume=/var/lib/hermes-agent/workspace:/opt/data/workspace

# Enable API server and dashboard
Environment=API_SERVER_ENABLED=true
Environment=API_SERVER_HOST=0.0.0.0
Environment=HERMES_DASHBOARD=1

# Secrets (username, password, dashboard secret, API key)
EnvironmentFile=/etc/hermes-agent/hermes-agent.env

# Command
Exec=gateway run

[Service]
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
