# Maintainer: Michael F <michael.fulthorp@gmail.com>
pkgname=hermes-agent
pkgver=0.0.1
pkgrel=3
pkgdesc="Hermes Agent gateway with API server and dashboard"
arch=('x86_64')
license=('MIT')
depends=(
  'podman'
  'systemd'
)
backup=('etc/hermes-agent/hermes-agent.env')
install=hermes-agent.install
source=(
  'hermes-agent.container'
  'hermes-agent.build'
  'Containerfile'
  'hermes-webui.container'
  'hermes-agent.env'
  'hermes'
  'sysusers.hermes-agent'
  'hermes-agent.sudoers'
)
sha256sums=(
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
  'SKIP'
)

package() {
  # Install the Quadlet container and build units
  install -Dm644 "${srcdir}/hermes-agent.container" "${pkgdir}/usr/share/containers/systemd/hermes-agent.container"
  install -Dm644 "${srcdir}/hermes-webui.container" "${pkgdir}/usr/share/containers/systemd/hermes-webui.container"
  install -Dm644 "${srcdir}/hermes-agent.build" "${pkgdir}/usr/share/containers/systemd/hermes-agent.build"

  # Install the Containerfile build context for the hermes-agent image
  install -Dm644 "${srcdir}/Containerfile" "${pkgdir}/usr/share/hermes-agent/build/Containerfile"

  # Install sysusers file for the hermes user and agent group
  install -Dm644 "${srcdir}/sysusers.hermes-agent" "${pkgdir}/usr/lib/sysusers.d/hermes-agent.conf"

  # Create data directories
  install -d -m 700 -o 10000 -g 10000 "${pkgdir}/var/lib/${pkgname}/hermes"
  install -d -m 755 -o 10000 -g 10000 "${pkgdir}/var/lib/${pkgname}/hermes-agent-src"
  install -d -m 2755 -o 10000 -g 10000 "${pkgdir}/var/lib/${pkgname}/workspace"

  # Install secrets template (user must fill in before starting)
  install -Dm644 "${srcdir}/hermes-agent.env" "${pkgdir}/etc/${pkgname}/hermes-agent.env"

  # Install the hermes CLI wrapper (includes `hermes install` setup wizard)
  install -Dm755 "${srcdir}/hermes" "${pkgdir}/usr/bin/hermes"

  # Install the NOPASSWD sudoers rule (scoped to the hermes CLI's podman commands)
  install -Dm440 "${srcdir}/hermes-agent.sudoers" "${pkgdir}/etc/sudoers.d/hermes-agent"
}
