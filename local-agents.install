post_install() {
  echo "=== Creating system users ==="
  systemd-sysusers

  echo "=== Reloading systemd manager configuration ==="
  systemctl enable vllm-qwen36.service hermes-agent.service
  systemctl daemon-reload

  echo ""
  echo "=== hermes-agent: run the setup wizard ==="
  echo "sudo hermes-agent-setup"
  echo "This will:"
  echo "  - Pull the hermes-agent image"
  echo "  - Run the interactive setup wizard (API keys, chat systems)"
  echo "  - Generate dashboard/API secrets"
}

post_upgrade() {
  post_install "$@"
}

post_remove() {
  echo "=== Stopping services ==="
  systemctl disable --now vllm-qwen36.service hermes-agent.service || true

  echo "=== Removing podman images ==="
  podman rmi docker.io/vllm/vllm-openai:latest || true
  podman rmi docker.io/nousresearch/hermes-agent:latest || true

  echo "=== Deleting local data in /var/lib/${pkgname} ==="
  rm -rf /var/lib/local-agents

  echo "=== Removing system users ==="
  userdel vllm || true
  userdel hermes || true

  echo "=== Reloading systemd manager configuration ==="
  systemctl daemon-reload
}
