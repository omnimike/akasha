[Unit]
Description=vLLM Qwen3.6-27B-FP8
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=on-failure
RestartSec=10

# Clean up any dead containers from previous runs
ExecStartPre=-/usr/bin/podman rm -f local-agents

# Run the container
ExecStart=/usr/bin/podman run \
  --name local-agents \
  -p 8080:8000 \
  --rm \
  --ipc=host \
  --device=nvidia.com/gpu=all \
  --userns=auto \
  sif:/usr/share/local-agents/local-agents.sif

ExecStop=/usr/bin/podman stop -t 10 local-agents

[Install]
WantedBy=agents.target
